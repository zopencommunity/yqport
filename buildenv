# bump: yq-version /YQ_VERSION="(.*)"/ https://github.com/mikefarah/yq.git|semver:^4
YQ_VERSION="4.53.6"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="utilities"
export ZOPEN_STABLE_URL="https://github.com/mikefarah/yq.git"
export ZOPEN_STABLE_DEPS="check_go grep gawk bash"
export ZOPEN_STABLE_TAG="v${YQ_VERSION}"

export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="go"
export ZOPEN_MAKE_OPTS="build"
export ZOPEN_MAKE_MINIMAL="yes"
export ZOPEN_CHECK="zopen_check"
export ZOPEN_INSTALL="zopen_install"
export ZOPEN_COMP=GO
export ZOPEN_NAME="yq-${ZOPEN_STABLE_TAG}"

zopen_init()
{
  # Go installs binaries, so create the bin dir as well
  export GOBIN=$ZOPEN_INSTALL_DIR/bin
  mkdir -p \$ZOPEN_INSTALL_DIR/bin
  unset CC CXX
  export CGO_ENABLED=0 # disable C Go as it's not needed in yq
  export GOMAXPROCS=1
}

zopen_check()
{
  bash ./scripts/acceptance.sh
}

zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  # shunit2 wraps the count in ANSI cyan codes - strip them before parsing
  # e.g. "Ran \033[1;36m35\033[0m tests." -> "Ran 35 tests."
  totalTests=$(sed 's/\x1b\[[0-9;]*m//g' "$chk" | grep -E "^Ran [0-9]+ tests?\." | awk '{sum += $2} END {print sum+0}')
  # shunit2 prints "ASSERT:..." on assertion failures and "shunit2:ERROR...returned non-zero" on test errors
  assertFails=$(grep -c "ASSERT:" "$chk" 2>/dev/null || echo 0)
  errorFails=$(grep -c "shunit2:ERROR.*returned non-zero" "$chk" 2>/dev/null || echo 0)
  actualFailures=$((assertFails + errorFails))

  echo "actualFailures:$actualFailures"
  echo "totalTests:$totalTests"
  echo "expectedFailures:5"
  echo "expectedTotalTests:$totalTests"
}

zopen_install()
{
  go install
}

zopen_get_version()
{
  $GOBIN/yq --version | cut -f4 -d' ' | sed "s#^v##g"
}
